# ==========================================
# DevCompanion Root .gitignore
# ==========================================

# ------------------------------------------
# Operating System Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------
# IDE & Editor Configurations
# ------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.settings/
.classpath
.project
*.sublime-workspace
*.sublime-project

# ------------------------------------------
# Java & Maven Artifacts (Backend)
# ------------------------------------------
**/target/
**/*.class
**/*.jar
**/*.war
**/*.ear
**/*.nar
**/*.zip
**/*.tar.gz
**/*.rar
hs_err_pid*
replay_pid*

# ------------------------------------------
# Node & Angular Artifacts (Frontend)
# ------------------------------------------
**/node_modules/
**/dist/
**/.angular/cache/
**/.angular/
**/.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Environment & Secrets
# ------------------------------------------
.env
.env.*
!.env.example
*.local

# ------------------------------------------
# Logs & Scratch Folders
# ------------------------------------------
logs/
*.log
scratch/
tmp/
temp/
